FROM node:22-alpine

LABEL org.opencontainers.image.title="Paróquia UI" \
      org.opencontainers.image.description="Frontend React + TypeScript + Vite para Gestão Paroquial" \
      org.opencontainers.image.source="https://github.com/brunoluizviana/paroquia"

WORKDIR /app

# Assegura que o diretório pertença ao usuário node
RUN chown -R node:node /app

# Copia manifestos de dependências
COPY --chown=node:node package.json package-lock.json ./

# Instala dependências de forma limpa e otimizada
RUN npm ci --prefer-offline

# Copia o código fonte com permissões de usuário
COPY --chown=node:node . .

EXPOSE 3000

ENV PORT=3000 \
    HOST=0.0.0.0

USER node

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
