FROM eclipse-temurin:25-jre-alpine

LABEL org.opencontainers.image.title="Paróquia API" \
      org.opencontainers.image.description="Spring Boot REST API para Gestão Paroquial" \
      org.opencontainers.image.source="https://github.com/brunoluizviana/paroquia"

WORKDIR /app

# Criar usuário sem privilégios para execução segura
RUN addgroup -S appgroup && adduser -S appuser -G appgroup && \
    chown -R appuser:appgroup /app

# Configurações de ambiente com suporte a contêineres e limites de memória
# DB_USER, DB_PASSWORD, APP_CRYPTO_KEY e APP_CONSENT_SECRET nao possuem valor padrao na imagem: devem ser
# injetados no deploy (a API aborta o boot sem os segredos).
ENV DB_URL=jdbc:postgresql://db:5432/calendario \
    PORT=8080 \
    JAVA_TOOL_OPTIONS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseSerialGC -Djdk.virtualThreadScheduler.parallelism=2"

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

USER appuser

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
