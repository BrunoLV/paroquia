# ===================================================================
# GESTÃO PARÓQUIA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copie para .env (ignorado pelo git) e substitua TODOS os valores <...>.
# Nenhuma credencial tem valor padrão: variáveis ausentes abortam o docker compose.
# Gere segredos com:  openssl rand -hex 32
# ===================================================================

# Database (usado pelo db, API, exporter e seeder)
POSTGRES_PASSWORD=<senha-forte-do-banco>

# API - segredos obrigatórios (>= 32 caracteres; a API não sobe sem eles)
# ATENÇÃO: trocar APP_CRYPTO_KEY depois de gravar dados torna ilegíveis os campos já cifrados.
APP_CRYPTO_KEY=<openssl rand -hex 32>
APP_CONSENT_SECRET=<openssl rand -hex 32>
# Token Bearer do Prometheus para raspar /actuator/prometheus
APP_METRICS_SCRAPE_TOKEN=<openssl rand -hex 24>

# API - rede e cookies
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# false somente em HTTP local; true em produção atrás de TLS
SESSION_COOKIE_SECURE=false

# pgAdmin
PGADMIN_DEFAULT_EMAIL=<email-do-administrador>
PGADMIN_DEFAULT_PASSWORD=<senha-forte-do-pgadmin>

# Grafana
GRAFANA_ADMIN_USER=grafana-admin
GRAFANA_ADMIN_PASSWORD=<senha-forte-do-grafana>
