# ===================================================================
# GESTÃO PARÓQUIA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ===================================================================

# Database Credentials & Configuration
POSTGRES_DB=calendario
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
DB_URL=jdbc:postgresql://db:5432/calendario
DB_USER=postgres
DB_PASSWORD=change_me_in_production

# Application API Server Configuration
PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_CRYPTO_KEY=generate_a_secure_random_32byte_hex_key_for_production

# Frontend UI Configuration (Vite)
VITE_API_URL=http://localhost:8080/api/v1
VITE_API_PROXY_TARGET=http://api:8080

# PgAdmin Management Console
PGADMIN_DEFAULT_EMAIL=admin@paroquia.local
PGADMIN_DEFAULT_PASSWORD=change_me_in_production
