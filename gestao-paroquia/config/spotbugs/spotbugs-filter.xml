<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/2.0.0 https://raw.githubusercontent.com/spotbugs/filter/2.0.0/src/site/resources/xsd/filter.xsd">

    <!-- 1. CÓDIGO GERADO AUTOMATICAMENTE: Ignora falsos positivos gerados pelo Lombok -->
    <Match>
        <Class name="~.*\.lombok\..*"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        <!-- Ignora avisos de exposição de representação interna comuns em DTOs/Getters/Setters gerados pelo Lombok -->
    </Match>

    <!-- 2. CAMADA DE TESTES: Ignora asserções e arquiteturas de teste de unidade/integração -->
    <Match>
        <Class name="~.*Test$"/>
    </Match>
    <Match>
        <Class name="~.*IT$"/>
    </Match>

    <!-- 3. ECOSSISTEMA SPRING: Ajustes para injeção de dependência via Proxy e Fields -->
    <Match>
        <Bug pattern="NP_NONNULL_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR" />
        <!-- Spring inicializa beans via reflexão tardia; o SpotBugs nativo acha que o campo ficará nulo -->
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE" />
        <!-- Evita conflito com blocos try-with-resources do Java moderno compilados no bytecode -->
    </Match>

    <!-- 4. DOMÍNIO RICO: construtores de agregados validam invariantes lançando exceção por design
         (objeto inválido nunca existe); o risco de "finalizer attack" do CT_CONSTRUCTOR_THROW não se aplica. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>

    <!-- 5. BASELINE (SpotBugs passou a ser bloqueante): achados legados congelados por classe+padrão.
         Qualquer achado NOVO, ou de outro padrão nestas classes, falha o build. Remova a entrada ao corrigir. -->
    <Match>
        <!-- Exportadores Excel/PDF/PPTX engolem falhas de renderização do logo/marca d'água de propósito (best effort). -->
        <Or>
            <Class name="br.com.nsfatima.gestao.calendario.infrastructure.export.ExportadorCalendarioExcel"/>
            <Class name="br.com.nsfatima.gestao.calendario.infrastructure.export.ExportadorCalendarioPptx"/>
            <Class name="~br\.com\.nsfatima\.gestao\.calendario\.infrastructure\.export\.ExportadorCalendarioPdf.*"/>
        </Or>
        <Bug pattern="DE_MIGHT_IGNORE,REC_CATCH_EXCEPTION"/>
    </Match>
    <Match>
        <Class name="br.com.nsfatima.gestao.calendario.application.usecase.configuracao.ObterLogoParoquiaUseCase"/>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>
    <Match>
        <!-- Detalhes do usuário mantém a entidade/lista de papéis como campo não serializável; sessão é por cookie/servidor. -->
        <Class name="br.com.nsfatima.gestao.iam.infrastructure.security.UsuarioDetails"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>
    <Match>
        <!-- DÉBITO REAL: nulo passado a parâmetro não-nulo do publisher de auditoria; corrigir no módulo fiel. -->
        <Class name="br.com.nsfatima.gestao.fiel.application.usecase.GerenciarRelacionamentoFamiliarUseCase"/>
        <Bug pattern="NP_NULL_PARAM_DEREF"/>
    </Match>
    <Match>
        <!-- DÉBITO REAL: correlation id vindo do header da requisição é devolvido no header da resposta; validar/sanitizar. -->
        <Class name="br.com.nsfatima.gestao.observabilidade.infrastructure.filter.CorrelationIdFilter"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>
    <Match>
        <!-- Suporte de teste monta corpo JSON com "\n" literal; irrelevante fora de String.format de produção. -->
        <Class name="br.com.nsfatima.gestao.calendario.support.SecurityTestSupport"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
</FindBugsFilter>
