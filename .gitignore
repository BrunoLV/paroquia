# Monorepo Root .gitignore

# IDEs & Editor Configuration
.vscode/
.idea/
*.swp
*.tmp
*.bak

# OS System Files
.DS_Store
Thumbs.db

# Java & Gradle (gestao-paroquia)
.gradle/
**/.gradle/
build/
**/build/
bin/
**/bin/
target/
**/target/
out/
**/out/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Node, React & Vite (gestao-paroquia-ui)
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
coverage/
**/coverage/
.vite/
**/.vite/
.pnp
.pnp.js
*.tsbuildinfo

# Environment & Secrets
.env
.env.local
.env.*.local
*.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Agent Scratch Files
.specify/
specs/
